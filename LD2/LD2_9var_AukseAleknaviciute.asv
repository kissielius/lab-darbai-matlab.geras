%%1a
a = -pi/2 : 2.5 : 3*pi;

%1b
b = a.^2;

%1c
c = sin(a+b);

%1d
c = c';

disp('1 užduoties rezultatas:')
disp(c)

%%2a
Z = rand(3,3);

disp('Gauta matrica:')
disp(Z)

%2b
Z(:,2) = [];

disp('Matrica panaikinus 2 stulpelį:')
disp(Z)

%2c
Z = Z';

disp('Transponuota matrica:')
disp(Z)

%%3
A = 5;
f = 4;
sigma = 2;
U1 = 3;
U2 = 1.5;
t = 0 : 0.001 : 1.2;
st = A*cos(2*pi*f*t);
n = sigma*randn(size(t));

s = st + n;

%3a
s_U1 = s(s > U1);

%3b
s_filtr = s;
s_filtr(abs(s_filtr) < U2) = 0;

%3c
dydis_nefiltr = size(s);

disp('Nefiltruoto signalo dydis:')
disp(dydis_nefiltr)

%3d
dydis_atr = size(s_U1);

disp('Atrinktų reikšmių dydis:')
disp(dydis_atr)

%3e
did_itampa = max(s_filtr);
maz_itampa = min(s_filtr);

disp('Didžiausia filtruoto signalo įtampos reikšmė:')
disp(did_itampa)

disp('Mažiausia filtruoto signalo įtampos reikšmė:')
disp(maz_itampa)

%Papildoma užduotis
A = [0 1 0 2 3 0 4;
    0 0 0 0 0 0 0;
    0 5 0 6 7 0 8;
    0 9 0 1 2 0 3;
    0 0 0 0 0 0 0;
    0 4 0 5 6 0 7];

eil = sum(A == 0, 2) == size(A, 2);
stulp = sum(A == 0, 1) == size(A, 1);

B = A(~eil, ~stulp);

disp('Papildomos užduoties gauta matrica:')
disp(B)